# ═══════════════════════════════════════════════════════════════════
#  TRACEBACK Frontend — .gitignore
#  API keys NEVER go in the frontend. Only NEXT_PUBLIC_ENGINE_URL
#  (a localhost URL) is used. All secrets live in the backend only.
# ═══════════════════════════════════════════════════════════════════

# ─── Environment / Secrets (NEVER commit these) ─────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
*.env

# ─── Next.js build artifacts ────────────────────────────────────────
.next/
out/
build/
dist/

# ─── Dependencies ────────────────────────────────────────────────────
node_modules/

# ─── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Vercel ──────────────────────────────────────────────────────────
.vercel/

# ─── IDE & OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
desktop.ini
