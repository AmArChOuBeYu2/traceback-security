# ═══════════════════════════════════════════════════════════════════════
#  TRACEBACK — Environment Variable Template
#
#  HOW TO USE:
#  1. Copy this file → .env  (root, for backend)
#  2. Copy frontend/.env.example → frontend/.env.local  (for Next.js)
#  3. Fill in your real keys in .env and frontend/.env.local
#  4. NEVER commit .env or .env.local — they are gitignored
#
#  SECURITY RULES:
#  - API keys live ONLY in the backend .env (never in the frontend)
#  - The frontend only receives NEXT_PUBLIC_ENGINE_URL (a localhost URL)
#  - NEXT_PUBLIC_ vars are baked into the browser bundle — never put
#    secrets there
# ═══════════════════════════════════════════════════════════════════════

# ─── Frontend (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# ─── Backend (FastAPI) ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ─── LLM Providers — BACKEND ONLY, never in frontend ────────────────
# Priority: OpenRouter → Gemini → deterministic fallback (no key needed)

# 1. OpenRouter (recommended) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use via OpenRouter (any model on openrouter.ai/models)
# Recommended: google/gemini-2.0-flash-001  (fast + cheap)
# Alternatives: anthropic/claude-3.5-haiku, openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# 2. Google Gemini (fallback if OpenRouter not set) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
